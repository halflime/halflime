{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halflime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "halflime", "migrations_dir": "migrations" }
  ],
  "secrets": { "required": ["ADMIN_TOKEN", "HASH_SECRET"] }
}
